# Copy to ../.env (next to the repository root) and fill in.
IBC2_USERNAME=
IBC2_MODE=paper
# Your local time zone; also what the "01:30 New York" nightly restart is converted into
TZ=America/New_York

# Alerts: set at least one so you hear about 2FA requests
IBC2_TELEGRAM_TOKEN=
IBC2_TELEGRAM_CHAT_ID=
IBC2_DISCORD_WEBHOOK=
IBC2_WEBHOOK_URL=
